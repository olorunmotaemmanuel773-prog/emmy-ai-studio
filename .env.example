# ------------------------------------------------------------------
#  EmmyAI Studio — environment variables (PLACEHOLDERS ONLY)
#  Copy to .env.local for local development.
#  In production set the same names in Vercel → Project → Settings →
#  Environment Variables. Never commit real values.
# ------------------------------------------------------------------

# --- Public (safe for the browser; protected by Row Level Security) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: deployed URL used for auth email redirects (defaults to the current origin)
VITE_APP_URL=

# --- Secret (SERVER-SIDE ONLY — read by the /api functions via process.env) ---
# Google AI Studio key used for Gemini (storyboards, premium images) and Veo (video).
# It has no VITE_ prefix on purpose: Vite never bundles it into the frontend.
GEMINI_API_KEY=

# Cloudflare Workers AI — the free text-to-image engine (server-side only).
# Free daily allocation, no credit card: https://developers.cloudflare.com/workers-ai/
# Account ID: Cloudflare dashboard → Workers & Pages (right column "Account ID").
# API token:  My Profile → API Tokens → Create Token with the "Workers AI: Edit" permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional model overrides (server-side)
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# CLOUDFLARE_IMG2IMG_MODEL=@cf/runwayml/stable-diffusion-v1-5-img2img
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# VEO_MODEL=veo-3.1-generate-preview
# VEO_DURATIONS=4,6,8
# VEO_RESOLUTION=720p
# ALLOWED_ORIGIN=https://your-domain.vercel.app

# ------------------------------------------------------------------
#  !!  Never put GEMINI_API_KEY, CLOUDFLARE_API_TOKEN or any Supabase
#  !!  service-role key in a VITE_* variable, in /src, in HTML, or in a
#  !!  public repository.
# ------------------------------------------------------------------
